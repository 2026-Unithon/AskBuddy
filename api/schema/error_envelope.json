{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "AUTH_REQUIRED",
            "FORBIDDEN",
            "NOT_FOUND",
            "V2_UNAVAILABLE",
            "INDEX_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "USAGE_UNAVAILABLE",
            "INTERNAL_ERROR",
            "INVALID_CONTRACT",
            "UNSUPPORTED_SCHEMA",
            "INVALID_REFERENCE",
            "STALE_DRAFT",
            "STALE_PUBLICATION",
            "STALE_KNOWLEDGE",
            "HASH_MISMATCH",
            "INDEX_PREPARE_FAILED",
            "INDEX_PREPARE_TIMEOUT",
            "CONTEXT_EXPIRED",
            "IDEMPOTENCY_CONFLICT",
            "RATE_LIMITED",
            "MODEL_UNAVAILABLE",
            "STORAGE_FAILED"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "request_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Ms"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "v2",
      "default": "v2",
      "title": "Contract Version",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
