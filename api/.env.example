# api/.env.example — 값은 커밋하지 않는다. cp .env.example .env 후 채운다
APP_NAME=askbuddy
ENV=local
ALLOWED_ORIGINS=http://localhost:3000

# ── LLM — api 에만 존재한다 (불변식 2). web/ 에 절대 두지 않는다
OPENAI_API_KEY=              # 임베딩(필수) + 답변 생성
GEMINI_API_KEY=              # 멀티모달 추출 (준혁)
ANTHROPIC_API_KEY=           # 선택. 있으면 채팅 모델 우선

# ── 고정값 (D3·D4). 바꾸면 임계값 전면 재측정
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CONFIDENCE_THRESHOLD=0.6
FRAME_INTERVAL_SEC=3

# ── Supabase — DB 자격증명도 api 에만 (불변식 3)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=        # 절대 프론트로 넘기지 않음
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── JWT
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
