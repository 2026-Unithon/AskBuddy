# api/.env.example — 값은 커밋하지 않는다. cp .env.example .env 후 채운다
APP_NAME=askbuddy
ENV=local
ALLOWED_ORIGINS=http://localhost:3000

# ── LLM — api 에만 존재한다 (불변식 2). web/ 에 절대 두지 않는다
# 인라인 주석 금지 — dotenv 가 값을 주석으로 먹을 수 있다
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── 고정값 (D3·D4·D11). 바꾸면 임계값 전면 재측정
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# CONFIDENCE_THRESHOLD  D3 — 카드 검수 우선노출. 검색 게이트와 무관
CONFIDENCE_THRESHOLD=0.6
# RETRIEVAL_THRESHOLD   D11 — 검색 게이트 하한. D3와 별개
#   실측: 우유 보관 0.640 / 우유 유통기한 0.473 / 환불 0.211
#   0.6 = 시드 질문 hit·나머지 miss / 0.4 = 추출 카드까지 hit / 0 = 무조건 hit
RETRIEVAL_THRESHOLD=0.6
FRAME_INTERVAL_SEC=3

# ── ingest (준혁)
# INGEST_MODE  mock: LLM 미호출 (M1 기본값) / real: Gemini 호출  (D10)
INGEST_MODE=mock
GEMINI_MODEL=gemini-2.5-flash
STT_MODEL=whisper-1

# ── Supabase — DB 자격증명도 api 에만 (불변식 3)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# STORAGE_BUCKET  비공개 버킷. scripts/init_storage.py 로 생성  (D8)
STORAGE_BUCKET=sources

# ── JWT — HS256 은 32바이트 이상. 배포 시 반드시 교체한다 (N8)
JWT_SECRET=dev-only-change-me-32bytes-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
