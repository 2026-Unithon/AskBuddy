# api/.env.example — 값은 커밋하지 않는다. cp .env.example .env 후 채운다
APP_NAME=askbuddy
ENV=local
ALLOWED_ORIGINS=http://localhost:3000

# ── LLM — api 에만 존재한다 (불변식 2). web/ 에 절대 두지 않는다
# 인라인 주석 금지 — dotenv 가 값을 주석으로 먹을 수 있다
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── 고정값 (D3·D4·D11). 바꾸면 임계값 전면 재측정
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# CONFIDENCE_THRESHOLD  D3 — 카드 검수 우선노출. 검색 게이트와 무관
CONFIDENCE_THRESHOLD=0.6
# RETRIEVAL_THRESHOLD   D11 — 검색 게이트 하한. D3 와 별개 값이다
#   실측: 우유 보관 0.640 / 우유 유통기한 0.473 / 주차장 0.333 / 환불 0.211 / 월급 0.120
#   실제 영상 추출 카드로 실측(2026-08-26, 관련 7 / 무관 6):
#     관련 질문 0.193~0.547 · 무관 질문 0.118~0.236
#   배포판 demo-cafe 실측(2026-08-26): 우유 0.640 · 유통기한 0.486 ·
#     시럽 0.379 · 아아 0.360 / 주차자리 0.430 · 주차장 0.348
#   '어디' 라는 말투가 겹쳐 오답이 정답보다 높게 나오는 구간이 있다.
#   8단계부터 점수와 별개로 질문 대상어가 카드에 실제 존재해야 hit가 된다.
RETRIEVAL_THRESHOLD=0.35
# 구버전 환경 호환용. 현재 검색 게이트는 이 값으로 대상어 검사를 우회하지 않는다.
RETRIEVAL_STRONG_SCORE=0.62
# grounded_llm: 승인 카드만 넣어 자연어 답변 생성, 실패 시 카드 원문 폴백
# extractive: LLM을 부르지 않고 검색된 카드 원문을 그대로 답변
ANSWER_MODE=grounded_llm
FRAME_INTERVAL_SEC=3

# 실자료 측정 후 필요한 제한만 환경변수로 추가한다. 미설정이면 capabilities에 null로 표시된다.
# INGEST_VOICE_MAX_BYTES=52428800
# INGEST_VOICE_MAX_DURATION_SEC=1800
# INGEST_VIDEO_MAX_BYTES=209715200
# INGEST_VIDEO_MAX_DURATION_SEC=1800
# INGEST_KAKAO_MAX_BYTES=20971520
# INGEST_SCAN_MAX_BYTES=52428800
# INGEST_SCAN_MAX_PAGES=100

# ── ingest (준혁)
# INGEST_MODE  mock: LLM 미호출 (M1 기본값) / real: Gemini 호출  (D10)
INGEST_MODE=mock
GEMINI_MODEL=gemini-3.6-flash
STT_MODEL=whisper-1

# ── Supabase — DB 자격증명도 api 에만 (불변식 3)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# STORAGE_BUCKET  비공개 버킷. scripts/init_storage.py 로 생성  (D8)
STORAGE_BUCKET=sources

# ── JWT — HS256 은 32바이트 이상. 배포 시 반드시 교체한다 (N8)
JWT_SECRET=dev-only-change-me-32bytes-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
