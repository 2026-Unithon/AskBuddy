# web/.env.example — cp .env.example .env.local
# NEXT_PUBLIC_SUPABASE_* 를 추가하지 않는다 — 브라우저는 Supabase 를 직접 치지 않는다 (불변식 1)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 초대 링크 미리보기의 기준 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 선택: 카카오톡 공유용 JavaScript 키 (REST API 키/Client Secret 아님)
NEXT_PUBLIC_KAKAO_JS_KEY=
